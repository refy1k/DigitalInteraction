<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DigitalInteraction.Views.Applications.ApplicationDetailPage"
             Title="Заявка"
             BackgroundColor="#F5F5F5">

    <ScrollView Padding="16">
        <VerticalStackLayout Spacing="12">

            <ActivityIndicator x:Name="LoadingIndicator"
                               IsVisible="True"
                               IsRunning="True"
                               Color="#1A237E"
                               HorizontalOptions="Center"
                               Margin="0,40,0,0" />

            <VerticalStackLayout x:Name="ContentLayout"
                                 IsVisible="False"
                                 Spacing="12">

                <Frame BackgroundColor="White" CornerRadius="10" Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label x:Name="NumberLabel"
                                   FontSize="13" TextColor="#757575" />
                            <Frame Grid.Column="1"
                                   x:Name="StatusFrame"
                                   Padding="8,3" CornerRadius="12"
                                   HasShadow="False">
                                <Label x:Name="StatusLabel"
                                       FontSize="11" TextColor="White" />
                            </Frame>
                        </Grid>
                        <Label x:Name="TitleLabel"
                               FontSize="17" FontAttributes="Bold"
                               TextColor="#212121" />
                        <Label x:Name="DateLabel"
                               FontSize="12" TextColor="#9E9E9E" />
                    </VerticalStackLayout>
                </Frame>

                <Frame BackgroundColor="White" CornerRadius="10" Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Текст заявки"
                               FontSize="13" FontAttributes="Bold"
                               TextColor="#424242" />
                        <BoxView HeightRequest="1" Color="#E0E0E0" />
                        <Label x:Name="TextLabel"
                               FontSize="14" TextColor="#212121"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Frame>

                <!-- Вложения -->
                <Frame x:Name="AttachmentsFrame"
                       BackgroundColor="White" CornerRadius="10"
                       Padding="16" IsVisible="False">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="📎 Прикреплённые файлы"
                           FontSize="13" FontAttributes="Bold"
                           TextColor="#424242" />
                        <BoxView HeightRequest="1" Color="#E0E0E0" />
                        <VerticalStackLayout x:Name="AttachmentsDetailLayout" Spacing="8" />
                    </VerticalStackLayout>
                </Frame>

                <Frame x:Name="ResponseFrame"
                       BackgroundColor="#E8F5E9"
                       CornerRadius="10" Padding="16"
                       IsVisible="False">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="✅ Ответ администрации"
                               FontSize="13" FontAttributes="Bold"
                               TextColor="#2E7D32" />
                        <BoxView HeightRequest="1" Color="#A5D6A7" />
                        <Label x:Name="ResponseLabel"
                               FontSize="14" TextColor="#212121"
                               LineBreakMode="WordWrap" />
                        <Label x:Name="ResponseDateLabel"
                               FontSize="12" TextColor="#757575" />
                    </VerticalStackLayout>
                </Frame>

                <Button x:Name="DeleteButton"
                        Text="Удалить заявку"
                        BackgroundColor="#B71C1C"
                        TextColor="White"
                        CornerRadius="8"
                        HeightRequest="50"
                        IsVisible="False"
                        Clicked="OnDeleteClicked" />

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>