<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DigitalInteraction.Views.Services.MunicipalServicesPage"
             Title="Муниципальные услуги"
             BackgroundColor="#F5F5F5">

    <Grid RowDefinitions="Auto, *">

        <!-- Поиск -->
        <SearchBar x:Name="SearchBar"
                   Grid.Row="0"
                   Placeholder="Поиск услуги..."
                   Margin="16,12,16,0"
                   TextChanged="OnSearchChanged" />

        <ScrollView Grid.Row="1" Padding="16,12,16,16">
            <VerticalStackLayout Spacing="12">

                <ActivityIndicator x:Name="LoadingIndicator"
                                   IsVisible="True"
                                   IsRunning="True"
                                   Color="#1A237E"
                                   HorizontalOptions="Center"
                                   Margin="0,40,0,0" />

                <!-- Категории -->
                <VerticalStackLayout x:Name="CategoriesLayout"
                                     IsVisible="False"
                                     Spacing="12" />

                <!-- Результаты поиска -->
                <VerticalStackLayout x:Name="SearchResultsLayout"
                                     IsVisible="False"
                                     Spacing="8" />

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>