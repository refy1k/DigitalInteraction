<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DigitalInteraction.Views.Profile.EmailVerificationPage"
             Title="Подтверждение email"
             BackgroundColor="#F5F5F5">

    <ScrollView Padding="16">
        <VerticalStackLayout Spacing="16">

            <!-- Статус подтверждения -->
            <Border x:Name="VerifiedBadge"
                    BackgroundColor="#E8F5E9"
                    StrokeThickness="0" Padding="16"
                    IsVisible="False">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                    <Label Text="✅" FontSize="20" VerticalOptions="Center" />
                    <Label Text="Email подтверждён"
                           FontSize="15" FontAttributes="Bold"
                           TextColor="#2E7D32"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <!-- Форма ввода email -->
            <Border x:Name="EmailInputLayout"
                    BackgroundColor="White"
                    StrokeThickness="0" Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="12">

                    <Label Text="Электронная почта"
                           FontSize="14" FontAttributes="Bold"
                           TextColor="#424242" />

                    <Label Text="Привяжите email для восстановления пароля и получения уведомлений."
                           FontSize="13" TextColor="#757575" />

                    <Label Text="Email" FontSize="12" TextColor="#9E9E9E" />
                    <Border BackgroundColor="#F8F9FA" StrokeThickness="0" Padding="12,10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Entry x:Name="EmailEntry"
                               Placeholder="example@mail.ru"
                               Keyboard="Email"
                               BackgroundColor="Transparent" />
                    </Border>

                    <Label x:Name="EmailError"
                           TextColor="Red" FontSize="13"
                           IsVisible="False" />

                    <Button x:Name="SendCodeButton"
                            Text="Отправить код"
                            BackgroundColor="#1A237E"
                            TextColor="White"
                            CornerRadius="8"
                            HeightRequest="46"
                            Clicked="OnSendCodeClicked" />

                </VerticalStackLayout>
            </Border>

            <!-- Форма ввода кода -->
            <Border x:Name="CodeInputLayout"
                    BackgroundColor="White"
                    StrokeThickness="1.5"
                    Stroke="#1A237E"
                    IsVisible="False"
                    Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="12">

                    <Label x:Name="CodeSentLabel"
                           FontSize="13" TextColor="#424242"
                           LineBreakMode="WordWrap" />

                    <Label Text="Введите код из письма"
                           FontSize="12" TextColor="#9E9E9E" />

                    <Border BackgroundColor="#F8F9FA" StrokeThickness="0" Padding="12,10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Entry x:Name="CodeEntry"
                               Placeholder="000000"
                               Keyboard="Numeric"
                               MaxLength="6"
                               BackgroundColor="Transparent"
                               FontSize="20"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center" />
                    </Border>

                    <Label x:Name="CodeError"
                           TextColor="Red" FontSize="13"
                           IsVisible="False" />

                    <Button x:Name="VerifyButton"
                            Text="Подтвердить"
                            BackgroundColor="#2E7D32"
                            TextColor="White"
                            CornerRadius="8"
                            HeightRequest="46"
                            Clicked="OnVerifyClicked" />

                    <Label Text="Отправить код повторно"
                           FontSize="12" TextColor="#1A237E"
                           TextDecorations="Underline"
                           HorizontalTextAlignment="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnResendTapped" />
                        </Label.GestureRecognizers>
                    </Label>

                </VerticalStackLayout>
            </Border>

            <ActivityIndicator x:Name="LoadingIndicator"
                               IsVisible="False" IsRunning="False"
                               Color="#1A237E"
                               HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>