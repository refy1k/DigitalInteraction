<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DigitalInteraction.Views.Profile.ContactInfoPage"
             Title="Контактная информация"
             BackgroundColor="#F5F5F5">

    <ScrollView Padding="16">
        <VerticalStackLayout Spacing="12">

            <ActivityIndicator x:Name="LoadingIndicator"
                               IsVisible="True"
                               IsRunning="True"
                               Color="#1A237E"
                               HorizontalOptions="Center"
                               Margin="0,40,0,0" />

            <VerticalStackLayout x:Name="ContentLayout"
                                 IsVisible="False"
                                 Spacing="12">

                <Frame BackgroundColor="White" CornerRadius="10" Padding="16">
                    <VerticalStackLayout Spacing="14">

                        <Label Text="Телефон"
                               FontSize="13" FontAttributes="Bold"
                               TextColor="#424242" />
                        <Entry x:Name="PhoneEntry"
                               Placeholder="+79991234567"
                               Keyboard="Telephone" />

                        <BoxView HeightRequest="1" Color="#F0F0F0" />

                        <Label Text="Email"
                               FontSize="13" FontAttributes="Bold"
                               TextColor="#424242" />
                        <Entry x:Name="EmailEntry"
                               Placeholder="example@mail.ru"
                               Keyboard="Email" />

                        <BoxView HeightRequest="1" Color="#F0F0F0" />

                        <Label Text="Адрес проживания"
                               FontSize="13" FontAttributes="Bold"
                               TextColor="#424242" />
                        <Editor x:Name="AddressEditor"
                                Placeholder="г. Берёзовский, ул. Ленина, д. 1, кв. 1"
                                HeightRequest="80"
                                AutoSize="Disabled"
                                BackgroundColor="White" />

                    </VerticalStackLayout>
                </Frame>

                <Label x:Name="ErrorLabel"
                       TextColor="Red" FontSize="13"
                       IsVisible="False" />

                <Label x:Name="SuccessLabel"
                       TextColor="#2E7D32" FontSize="13"
                       IsVisible="False"
                       HorizontalTextAlignment="Center" />

                <Button x:Name="SaveButton"
                        Text="Сохранить"
                        BackgroundColor="#1A237E"
                        TextColor="White"
                        CornerRadius="8"
                        HeightRequest="50"
                        Clicked="OnSaveClicked" />

                <ActivityIndicator x:Name="SavingIndicator"
                                   IsVisible="False"
                                   IsRunning="False"
                                   Color="#1A237E"
                                   HorizontalOptions="Center" />

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>