<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DigitalInteraction.Views.Profile.DocumentsEditPage"
             Title="Редактировать документы"
             BackgroundColor="#F5F5F5">

    <ScrollView Padding="16">
        <VerticalStackLayout Spacing="12">

            <Frame BackgroundColor="White" CornerRadius="10" Padding="16">
                <VerticalStackLayout Spacing="14">

                    <Label Text="Паспорт (серия и номер)"
                           FontSize="13" FontAttributes="Bold" TextColor="#424242" />
                    <Entry x:Name="PassportEntry"
                           Placeholder="1234 567890"
                           Keyboard="Numeric" />

                    <BoxView HeightRequest="1" Color="#F0F0F0" />

                    <Label Text="СНИЛС"
                           FontSize="13" FontAttributes="Bold" TextColor="#424242" />
                    <Entry x:Name="SnilsEntry"
                           Placeholder="123-456-789 01" />

                    <BoxView HeightRequest="1" Color="#F0F0F0" />

                    <Label Text="ИНН"
                           FontSize="13" FontAttributes="Bold" TextColor="#424242" />
                    <Entry x:Name="InnEntry"
                           Placeholder="123456789012"
                           Keyboard="Numeric" />

                    <BoxView HeightRequest="1" Color="#F0F0F0" />

                    <Label Text="Полис ОМС"
                           FontSize="13" FontAttributes="Bold" TextColor="#424242" />
                    <Entry x:Name="OmsEntry"
                           Placeholder="1234567890123456"
                           Keyboard="Numeric" />

                </VerticalStackLayout>
            </Frame>

            <Label x:Name="ErrorLabel"
                   TextColor="Red" FontSize="13" IsVisible="False" />
            <Label x:Name="SuccessLabel"
                   TextColor="#2E7D32" FontSize="13" IsVisible="False"
                   HorizontalTextAlignment="Center" />

            <Button x:Name="SaveButton"
                    Text="Сохранить"
                    BackgroundColor="#1A237E"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="50"
                    Clicked="OnSaveClicked" />

            <ActivityIndicator x:Name="SavingIndicator"
                               IsVisible="False" IsRunning="False"
                               Color="#1A237E" HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>