<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DigitalInteraction.Views.Profile.DocumentsPage"
             Title="Мои документы"
             BackgroundColor="#F5F5F5">

    <ScrollView Padding="16">
        <VerticalStackLayout Spacing="16">

            <ActivityIndicator x:Name="LoadingIndicator"
                               IsVisible="True"
                               IsRunning="True"
                               Color="#1A237E"
                               HorizontalOptions="Center"
                               Margin="0,40,0,0" />

            <VerticalStackLayout x:Name="ContentLayout"
                                 IsVisible="False"
                                 Spacing="16">

                <!-- Паспорт -->
                <Frame BackgroundColor="#1A237E" CornerRadius="16"
                       Padding="20" HasShadow="True">
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="16">
                        <Label Grid.Column="0" Text="🪪"
                               FontSize="36" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="ПАСПОРТ РФ"
                                   FontSize="11" TextColor="#90CAF9"
                                   FontAttributes="Bold"
                                   CharacterSpacing="2" />
                            <Label x:Name="PassportNumberLabel"
                                   FontSize="22" FontAttributes="Bold"
                                   TextColor="White" />
                            <Label Text="Серия и номер"
                                   FontSize="11" TextColor="#90CAF9" />
                        </VerticalStackLayout>
                    </Grid>
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPassportTapped" />
                    </Frame.GestureRecognizers>
                </Frame>

                <!-- СНИЛС -->
                <Frame BackgroundColor="#1B5E20" CornerRadius="16"
                       Padding="20" HasShadow="True">
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="16">
                        <Label Grid.Column="0" Text="🟢"
                               FontSize="36" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="СНИЛС"
                                   FontSize="11" TextColor="#A5D6A7"
                                   FontAttributes="Bold"
                                   CharacterSpacing="2" />
                            <Label x:Name="SnilsNumberLabel"
                                   FontSize="22" FontAttributes="Bold"
                                   TextColor="White" />
                            <Label Text="Страховой номер"
                                   FontSize="11" TextColor="#A5D6A7" />
                        </VerticalStackLayout>
                    </Grid>
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSnilsTapped" />
                    </Frame.GestureRecognizers>
                </Frame>

                <!-- ИНН -->
                <Frame BackgroundColor="#E65100" CornerRadius="16"
                       Padding="20" HasShadow="True">
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="16">
                        <Label Grid.Column="0" Text="📋"
                               FontSize="36" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="ИНН"
                                   FontSize="11" TextColor="#FFCCBC"
                                   FontAttributes="Bold"
                                   CharacterSpacing="2" />
                            <Label x:Name="InnNumberLabel"
                                   FontSize="22" FontAttributes="Bold"
                                   TextColor="White" />
                            <Label Text="Идентификационный номер"
                                   FontSize="11" TextColor="#FFCCBC" />
                        </VerticalStackLayout>
                    </Grid>
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnInnTapped" />
                    </Frame.GestureRecognizers>
                </Frame>

                <!-- ОМС -->
                <Frame BackgroundColor="#4A148C" CornerRadius="16"
                       Padding="20" HasShadow="True">
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="16">
                        <Label Grid.Column="0" Text="💊"
                               FontSize="36" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="ПОЛИС ОМС"
                                   FontSize="11" TextColor="#CE93D8"
                                   FontAttributes="Bold"
                                   CharacterSpacing="2" />
                            <Label x:Name="OmsNumberLabel"
                                   FontSize="22" FontAttributes="Bold"
                                   TextColor="White" />
                            <Label Text="Обязательное медицинское страхование"
                                   FontSize="11" TextColor="#CE93D8" />
                        </VerticalStackLayout>
                    </Grid>
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnOmsTapped" />
                    </Frame.GestureRecognizers>
                </Frame>

                <!-- Кнопка редактировать -->
                <Button Text="✏️  Редактировать документы"
                        BackgroundColor="White"
                        TextColor="#1A237E"
                        BorderColor="#1A237E"
                        BorderWidth="1.5"
                        CornerRadius="8"
                        HeightRequest="50"
                        Clicked="OnEditClicked" />

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>