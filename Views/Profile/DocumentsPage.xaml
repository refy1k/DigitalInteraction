<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DigitalInteraction.Views.Profile.DocumentsPage"
             Title="Мои документы"
             BackgroundColor="#F5F5F5">

    <ScrollView Padding="16">
        <VerticalStackLayout Spacing="12">

            <ActivityIndicator x:Name="LoadingIndicator"
                               IsVisible="True"
                               IsRunning="True"
                               Color="#1A237E"
                               HorizontalOptions="Center"
                               Margin="0,40,0,0" />

            <VerticalStackLayout x:Name="ContentLayout"
                                 IsVisible="False"
                                 Spacing="12">

                <Frame BackgroundColor="White" CornerRadius="10" Padding="16">
                    <VerticalStackLayout Spacing="14">

                        <Label Text="Паспорт"
                               FontSize="13" FontAttributes="Bold"
                               TextColor="#424242" />
                        <Entry x:Name="PassportEntry"
                               Placeholder="1234 567890"
                               Keyboard="Numeric" />

                        <BoxView HeightRequest="1" Color="#F0F0F0" />

                        <Label Text="СНИЛС"
                               FontSize="13" FontAttributes="Bold"
                               TextColor="#424242" />
                        <Entry x:Name="SnilsEntry"
                               Placeholder="123-456-789 01"
                               Keyboard="Numeric" />

                        <BoxView HeightRequest="1" Color="#F0F0F0" />

                        <Label Text="ИНН"
                               FontSize="13" FontAttributes="Bold"
                               TextColor="#424242" />
                        <Entry x:Name="InnEntry"
                               Placeholder="123456789012"
                               Keyboard="Numeric" />

                        <BoxView HeightRequest="1" Color="#F0F0F0" />

                        <Label Text="Полис ОМС"
                               FontSize="13" FontAttributes="Bold"
                               TextColor="#424242" />
                        <Entry x:Name="OmsEntry"
                               Placeholder="1234567890123456"
                               Keyboard="Numeric" />

                    </VerticalStackLayout>
                </Frame>

                <Label Text="* Данные хранятся только для удобства заполнения заявок"
                       FontSize="12" TextColor="#9E9E9E"
                       HorizontalTextAlignment="Center" />

                <Label x:Name="ErrorLabel"
                       TextColor="Red" FontSize="13"
                       IsVisible="False" />

                <Label x:Name="SuccessLabel"
                       TextColor="#2E7D32" FontSize="13"
                       IsVisible="False"
                       HorizontalTextAlignment="Center" />

                <Button x:Name="SaveButton"
                        Text="Сохранить"
                        BackgroundColor="#1A237E"
                        TextColor="White"
                        CornerRadius="8"
                        HeightRequest="50"
                        Clicked="OnSaveClicked" />

                <ActivityIndicator x:Name="SavingIndicator"
                                   IsVisible="False"
                                   IsRunning="False"
                                   Color="#1A237E"
                                   HorizontalOptions="Center" />

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>