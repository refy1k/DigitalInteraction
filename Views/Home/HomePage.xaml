<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DigitalInteraction.Views.Home.HomePage"
             Title="Главная"
             BackgroundColor="#F5F5F5">

    <RefreshView x:Name="RefreshView"
                 Refreshing="OnRefreshing">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="16">

                <!-- Приветствие -->
                <Frame BackgroundColor="#1A237E"
                       CornerRadius="12"
                       Padding="16"
                       HasShadow="True">
                    <VerticalStackLayout Spacing="4">
                        <Label x:Name="GreetingLabel"
                               Text="Добро пожаловать!"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="White" />
                        <Label x:Name="DateLabel"
                               FontSize="13"
                               TextColor="#B0BEC5" />
                    </VerticalStackLayout>
                </Frame>

                <!-- Погода -->
                <Frame CornerRadius="12"
                       Padding="16"
                       HasShadow="True"
                       BackgroundColor="White">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="🌤 Погода — Берёзовский"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#424242" />

                        <ActivityIndicator x:Name="WeatherLoading"
                                           IsVisible="True"
                                           IsRunning="True"
                                           Color="#1A237E"
                                           HorizontalOptions="Start" />

                        <VerticalStackLayout x:Name="WeatherContent"
                                             IsVisible="False"
                                             Spacing="4">
                            <Label x:Name="WeatherTempLabel"
                                   FontSize="32"
                                   FontAttributes="Bold"
                                   TextColor="#1A237E" />
                            <Label x:Name="WeatherDescLabel"
                                   FontSize="14"
                                   TextColor="#616161" />
                            <HorizontalStackLayout Spacing="16">
                                <Label x:Name="WeatherHumidityLabel"
                                       FontSize="13"
                                       TextColor="#757575" />
                                <Label x:Name="WeatherWindLabel"
                                       FontSize="13"
                                       TextColor="#757575" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <Label x:Name="WeatherErrorLabel"
                               IsVisible="False"
                               TextColor="Red"
                               FontSize="13" />
                    </VerticalStackLayout>
                </Frame>

                <!-- Статистика -->
                <Frame CornerRadius="12"
                       Padding="16"
                       HasShadow="True"
                       BackgroundColor="White">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="📊 Мои обращения и заявки"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#424242" />

                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                            <!-- Всего -->
                            <Frame Grid.Column="0"
                                   BackgroundColor="#E8EAF6"
                                   CornerRadius="8"
                                   Padding="12,8">
                                <VerticalStackLayout HorizontalOptions="Center">
                                    <Label x:Name="TotalCountLabel"
                                           Text="0"
                                           FontSize="22"
                                           FontAttributes="Bold"
                                           TextColor="#1A237E"
                                           HorizontalTextAlignment="Center" />
                                    <Label Text="Всего"
                                           FontSize="11"
                                           TextColor="#757575"
                                           HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Frame>
                            <!-- В обработке -->
                            <Frame Grid.Column="1"
                                   BackgroundColor="#FFF8E1"
                                   CornerRadius="8"
                                   Padding="12,8">
                                <VerticalStackLayout HorizontalOptions="Center">
                                    <Label x:Name="ActiveCountLabel"
                                           Text="0"
                                           FontSize="22"
                                           FontAttributes="Bold"
                                           TextColor="#F57F17"
                                           HorizontalTextAlignment="Center" />
                                    <Label Text="В работе"
                                           FontSize="11"
                                           TextColor="#757575"
                                           HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Frame>
                            <!-- Выполнено -->
                            <Frame Grid.Column="2"
                                   BackgroundColor="#E8F5E9"
                                   CornerRadius="8"
                                   Padding="12,8">
                                <VerticalStackLayout HorizontalOptions="Center">
                                    <Label x:Name="DoneCountLabel"
                                           Text="0"
                                           FontSize="22"
                                           FontAttributes="Bold"
                                           TextColor="#2E7D32"
                                           HorizontalTextAlignment="Center" />
                                    <Label Text="Выполнено"
                                           FontSize="11"
                                           TextColor="#757575"
                                           HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Frame>
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <!-- Контакты администрации -->
                <Frame CornerRadius="12"
                       Padding="16"
                       HasShadow="True"
                       BackgroundColor="White">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="📞 Контакты администрации"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#424242" />

                        <BoxView HeightRequest="1" Color="#E0E0E0" />

                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto"
                              ColumnSpacing="12" RowSpacing="8">

                            <Label Grid.Row="0" Grid.Column="0" Text="📍" FontSize="16" VerticalOptions="Center"/>
                            <Label Grid.Row="0" Grid.Column="1"
                                   Text="Пермский край, г. Берёзовский, ул. Ленина, 33"
                                   FontSize="13" TextColor="#424242" />

                            <Label Grid.Row="1" Grid.Column="0" Text="📞" FontSize="16" VerticalOptions="Center"/>
                            <Label Grid.Row="1" Grid.Column="1"
                                   Text="+7 (342) 513-12-33"
                                   FontSize="13" TextColor="#1A237E"
                                   TextDecorations="Underline">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnPhoneTapped" />
                                </Label.GestureRecognizers>
                            </Label>

                            <Label Grid.Row="2" Grid.Column="0" Text="✉️" FontSize="16" VerticalOptions="Center"/>
                            <Label Grid.Row="2" Grid.Column="1"
                                   Text="berra_07@mail.ru"
                                   FontSize="13" TextColor="#1A237E"
                                   TextDecorations="Underline">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnEmailTapped" />
                                </Label.GestureRecognizers>
                            </Label>

                            <Label Grid.Row="3" Grid.Column="0" Text="🕐" FontSize="16" VerticalOptions="Center"/>
                            <Label Grid.Row="3" Grid.Column="1"
                                   Text="Пн–Пт: 9:00–18:00, обед 13:00–14:00"
                                   FontSize="13" TextColor="#424242" />
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <!-- Новости -->
                <Frame CornerRadius="12"
                       Padding="16"
                       HasShadow="True"
                       BackgroundColor="White">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="📰 Новости Пермского края"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#424242" />

                        <ActivityIndicator x:Name="NewsLoading"
                                           IsVisible="True"
                                           IsRunning="True"
                                           Color="#1A237E"
                                           HorizontalOptions="Start" />

                        <VerticalStackLayout x:Name="NewsContent"
                                             IsVisible="False"
                                             Spacing="0" />

                        <Label x:Name="NewsErrorLabel"
                               IsVisible="False"
                               TextColor="Red"
                               FontSize="13" />
                    </VerticalStackLayout>
                </Frame>

                <BoxView HeightRequest="20" Color="Transparent" />

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>