<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DigitalInteraction.Views.Home.HomePage"
             Title="Главная"
             BackgroundColor="#F0F2F5">

    <RefreshView x:Name="RefreshView" Refreshing="OnRefreshing">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="16">

                <!-- Шапка с приветствием и погодой -->
                <Border BackgroundColor="#1A237E"
                        StrokeThickness="0"
                        Padding="20,18">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto, Auto"
                          RowSpacing="4">

                        <Label Grid.Row="0" Grid.Column="0"
                               x:Name="GreetingLabel"
                               FontSize="20" FontAttributes="Bold"
                               TextColor="White" />

                        <!-- Погода справа -->
                        <VerticalStackLayout Grid.Row="0" Grid.Column="1"
                                             Grid.RowSpan="3"
                                             HorizontalOptions="End"
                                             VerticalOptions="Center"
                                             Spacing="2">
                            <ActivityIndicator x:Name="WeatherLoading"
                                               IsVisible="True"
                                               IsRunning="True"
                                               Color="White"
                                               WidthRequest="30" />
                            <VerticalStackLayout x:Name="WeatherWidget"
                                                 IsVisible="False"
                                                 HorizontalOptions="End">
                                <Label x:Name="WeatherTempLabel"
                                       FontSize="28" FontAttributes="Bold"
                                       TextColor="White"
                                       HorizontalTextAlignment="End" />
                                <Label x:Name="WeatherDescLabel"
                                       FontSize="11" TextColor="#B0BEC5"
                                       HorizontalTextAlignment="End" />
                                <Label x:Name="WeatherWindLabel"
                                       FontSize="11" TextColor="#B0BEC5"
                                       HorizontalTextAlignment="End" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>

                        <Label Grid.Row="1" Grid.Column="0"
                               x:Name="DateLabel"
                               FontSize="13" TextColor="#B0BEC5" />

                        <Label Grid.Row="2" Grid.Column="0"
                               x:Name="WeatherErrorLabel"
                               IsVisible="False"
                               FontSize="11" TextColor="#EF9A9A" />
                    </Grid>
                </Border>

                <!-- Быстрые действия -->
                <Label Text="Быстрые действия"
                       FontSize="15" FontAttributes="Bold"
                       TextColor="#424242" />

                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto"
                      ColumnSpacing="12" RowSpacing="12">

                    <!-- Новое обращение -->
                    <Border Grid.Row="0" Grid.Column="0"
                            BackgroundColor="#1A237E"
                            StrokeThickness="0" Padding="14">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="✉️" FontSize="28" />
                            <Label Text="Новое обращение"
                                   FontSize="13" FontAttributes="Bold"
                                   TextColor="White" />
                            <Label Text="Написать в администрацию"
                                   FontSize="11" TextColor="#90CAF9"
                                   LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNewAppealTapped" />
                        </Border.GestureRecognizers>
                    </Border>

                    <!-- Новая заявка -->
                    <Border Grid.Row="0" Grid.Column="1"
                            BackgroundColor="#1B5E20"
                            StrokeThickness="0" Padding="14">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="📋" FontSize="28" />
                            <Label Text="Новая заявка"
                                   FontSize="13" FontAttributes="Bold"
                                   TextColor="White" />
                            <Label Text="Подать заявление"
                                   FontSize="11" TextColor="#A5D6A7"
                                   LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNewApplicationTapped" />
                        </Border.GestureRecognizers>
                    </Border>

                    <!-- Муниципальные услуги -->
                    <Border Grid.Row="1" Grid.Column="0"
                            BackgroundColor="#E65100"
                            StrokeThickness="0" Padding="14">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="🏛️" FontSize="28" />
                            <Label Text="Услуги"
                                   FontSize="13" FontAttributes="Bold"
                                   TextColor="White" />
                            <Label Text="Муниципальные услуги"
                                   FontSize="11" TextColor="#FFCCBC"
                                   LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnServicesTapped" />
                        </Border.GestureRecognizers>
                    </Border>

                    <!-- Профиль -->
                    <Border Grid.Row="1" Grid.Column="1"
                            BackgroundColor="#4A148C"
                            StrokeThickness="0" Padding="14">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="👤" FontSize="28" />
                            <Label Text="Профиль"
                                   FontSize="13" FontAttributes="Bold"
                                   TextColor="White" />
                            <Label Text="Мои данные и документы"
                                   FontSize="11" TextColor="#CE93D8"
                                   LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnProfileTapped" />
                        </Border.GestureRecognizers>
                    </Border>

                </Grid>

                <!-- Статистика -->
                <Label Text="Моя активность"
                       FontSize="15" FontAttributes="Bold"
                       TextColor="#424242" />

                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">

                    <Border Grid.Column="0"
                            BackgroundColor="White"
                            StrokeThickness="0" Padding="12,10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                            <Label x:Name="AppealsCountLabel"
                                   Text="0" FontSize="24" FontAttributes="Bold"
                                   TextColor="#1A237E"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="Обращений"
                                   FontSize="11" TextColor="#9E9E9E"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1"
                            BackgroundColor="White"
                            StrokeThickness="0" Padding="12,10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                            <Label x:Name="ApplicationsCountLabel"
                                   Text="0" FontSize="24" FontAttributes="Bold"
                                   TextColor="#1B5E20"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="Заявок"
                                   FontSize="11" TextColor="#9E9E9E"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="2"
                            BackgroundColor="White"
                            StrokeThickness="0" Padding="12,10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                            <Label x:Name="ServicesCountLabel"
                                   Text="0" FontSize="24" FontAttributes="Bold"
                                   TextColor="#E65100"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="Услуг"
                                   FontSize="11" TextColor="#9E9E9E"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>

                </Grid>

                <!-- Статусы активных обращений -->
                <Label Text="Активные обращения"
                       FontSize="15" FontAttributes="Bold"
                       TextColor="#424242" />

                <VerticalStackLayout x:Name="ActiveAppealsLayout" Spacing="8" />

                <Label x:Name="NoActiveAppealsLabel"
                       Text="Нет активных обращений"
                       FontSize="13" TextColor="#9E9E9E"
                       HorizontalTextAlignment="Center"
                       IsVisible="False" />

                <!-- Контакты администрации -->
                <Label Text="Контакты администрации"
                       FontSize="15" FontAttributes="Bold"
                       TextColor="#424242" />

                <Border BackgroundColor="White"
                        StrokeThickness="0" Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto,*"
                          RowDefinitions="Auto,Auto,Auto,Auto"
                          ColumnSpacing="12" RowSpacing="12">

                        <Label Grid.Row="0" Grid.Column="0"
                               Text="📍" FontSize="16" VerticalOptions="Center" />
                        <Label Grid.Row="0" Grid.Column="1"
                               Text="Пермский край, с. Берёзовка, ул. Ленина, 33"
                               FontSize="13" TextColor="#424242" />

                        <Label Grid.Row="1" Grid.Column="0"
                               Text="📞" FontSize="16" VerticalOptions="Center" />
                        <Label Grid.Row="1" Grid.Column="1"
                               Text="+7 (342) 513-12-33"
                               FontSize="13" TextColor="#1A237E"
                               TextDecorations="Underline">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPhoneTapped" />
                            </Label.GestureRecognizers>
                        </Label>

                        <Label Grid.Row="2" Grid.Column="0"
                               Text="✉️" FontSize="16" VerticalOptions="Center" />
                        <Label Grid.Row="2" Grid.Column="1"
                               Text="berra_07@mail.ru"
                               FontSize="13" TextColor="#1A237E"
                               TextDecorations="Underline">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnEmailTapped" />
                            </Label.GestureRecognizers>
                        </Label>

                        <Label Grid.Row="3" Grid.Column="0"
                               Text="🕐" FontSize="16" VerticalOptions="Center" />
                        <Label Grid.Row="3" Grid.Column="1"
                               Text="Пн–Пт: 8:30–17:30, обед 12:30–14:00"
                               FontSize="13" TextColor="#424242" />
                    </Grid>
                </Border>

                <!-- Новости -->
                <Label Text="Новости Пермского края"
                       FontSize="15" FontAttributes="Bold"
                       TextColor="#424242" />

                <Border BackgroundColor="White"
                        StrokeThickness="0" Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="8">

                        <ActivityIndicator x:Name="NewsLoading"
                                           IsVisible="True" IsRunning="True"
                                           Color="#1A237E"
                                           HorizontalOptions="Start" />

                        <VerticalStackLayout x:Name="NewsContent"
                                             IsVisible="False" Spacing="0" />

                        <Label x:Name="NewsErrorLabel"
                               IsVisible="False"
                               TextColor="Red" FontSize="13" />
                    </VerticalStackLayout>
                </Border>

                <BoxView HeightRequest="20" Color="Transparent" />

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>