<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DigitalInteraction.Views.Auth.ForgotPasswordPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F5F5F5">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="16"
                             VerticalOptions="Center">

            <Label Text="Восстановление пароля"
                   FontSize="24" FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   TextColor="#1A237E"
                   Margin="0,40,0,0" />

            <Label Text="Введите email привязанный к вашему аккаунту. На него придёт новый пароль."
                   FontSize="13" TextColor="#757575"
                   HorizontalTextAlignment="Center"
                   Margin="0,0,0,20" />

            <Label Text="Email" FontSize="13" TextColor="#424242" />
            <Entry x:Name="EmailEntry"
                   Placeholder="example@mail.ru"
                   Keyboard="Email"
                   ReturnType="Done" />

            <Label x:Name="ErrorLabel"
                   TextColor="Red" FontSize="13"
                   IsVisible="False"
                   HorizontalTextAlignment="Center" />

            <Label x:Name="SuccessLabel"
                   TextColor="#2E7D32" FontSize="13"
                   IsVisible="False"
                   HorizontalTextAlignment="Center" />

            <Button x:Name="SendButton"
                    Text="Отправить новый пароль"
                    BackgroundColor="#1A237E"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="50"
                    Clicked="OnSendClicked"
                    Margin="0,10,0,0" />

            <ActivityIndicator x:Name="LoadingIndicator"
                               IsVisible="False" IsRunning="False"
                               Color="#1A237E"
                               HorizontalOptions="Center" />

            <Label Text="Вернуться к входу"
                   FontSize="13" TextColor="#1A237E"
                   TextDecorations="Underline"
                   HorizontalTextAlignment="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Label.GestureRecognizers>
            </Label>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>