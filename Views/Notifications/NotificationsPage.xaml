<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DigitalInteraction.Views.Notifications.NotificationsPage"
             Title="Уведомления"
             BackgroundColor="#F5F5F5">

    <Grid RowDefinitions="*, Auto" Padding="16">

        <ActivityIndicator x:Name="LoadingIndicator"
                           IsVisible="False"
                           IsRunning="False"
                           Color="#1A237E"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />

        <VerticalStackLayout x:Name="EmptyView"
                             IsVisible="False"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Spacing="8">
            <Label Text="🔔" FontSize="48" HorizontalTextAlignment="Center" />
            <Label Text="Уведомлений пока нет"
                   FontSize="16" TextColor="#757575"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <CollectionView x:Name="NotificationsCollection"
                        IsVisible="False">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="0,6" Padding="16"
                           CornerRadius="10" HasShadow="True">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNotificationTapped"
                                                  CommandParameter="{Binding .}" />
                        </Frame.GestureRecognizers>
                        <Frame.Triggers>
                            <DataTrigger TargetType="Frame"
                                         Binding="{Binding IsRead}"
                                         Value="False">
                                <Setter Property="BackgroundColor" Value="#E8EAF6" />
                            </DataTrigger>
                            <DataTrigger TargetType="Frame"
                                         Binding="{Binding IsRead}"
                                         Value="True">
                                <Setter Property="BackgroundColor" Value="White" />
                            </DataTrigger>
                        </Frame.Triggers>

                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12">

                            <!-- Индикатор непрочитанного -->
                            <BoxView Grid.Column="0"
                                     WidthRequest="8"
                                     HeightRequest="8"
                                     CornerRadius="4"
                                     VerticalOptions="Start"
                                     Margin="0,6,0,0">
                                <BoxView.Triggers>
                                    <DataTrigger TargetType="BoxView"
                                                 Binding="{Binding IsRead}"
                                                 Value="False">
                                        <Setter Property="Color" Value="#1A237E" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="BoxView"
                                                 Binding="{Binding IsRead}"
                                                 Value="True">
                                        <Setter Property="Color" Value="Transparent" />
                                    </DataTrigger>
                                </BoxView.Triggers>
                            </BoxView>

                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="{Binding Title}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="#212121" />
                                <Label Text="{Binding Message}"
                                       FontSize="13"
                                       TextColor="#424242"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="2" />
                                <Label Text="{Binding CreatedAt, StringFormat='{0:dd.MM.yyyy HH:mm}'}"
                                       FontSize="11"
                                       TextColor="#9E9E9E" />
                            </VerticalStackLayout>

                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Кнопка прочитать все -->
        <Button Grid.Row="1"
                x:Name="MarkAllReadButton"
                Text="Отметить все как прочитанные"
                BackgroundColor="#1A237E"
                TextColor="White"
                CornerRadius="8"
                HeightRequest="50"
                IsVisible="False"
                Margin="0,8,0,0"
                Clicked="OnMarkAllReadClicked" />

    </Grid>

</ContentPage>